{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["packages/config-typescript/**", "packages/config-eslint/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV"]
    },
    "lint": { "dependsOn": ["^lint"], "outputs": [] },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV"]
    },
    "test:e2e": { "dependsOn": ["build"], "outputs": [], "env": ["NODE_ENV"] },
    "dev": { "cache": false, "persistent": true, "env": ["NODE_ENV"] }
  }
}
