{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["packages/config-typescript/**", "packages/config-eslint/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/*.test.*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        // @module:auth
        "APP_ORIGIN",
        "SESSION_SECRET",
        "SESSION_SECRET_PREVIOUS",
        "SESSION_MAX_AGE_SECONDS",
        "SESSION_REFRESH_SKEW_SECONDS",
        // @end-module:auth
        "API_URL",
        "API_TIMEOUT_MS",
        "CSP_REPORT_URI"
      ]
    },
    "lint": { "dependsOn": ["^build"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV"]
    },
    "test:e2e": { "dependsOn": ["build"], "outputs": [], "env": ["NODE_ENV"] },
    "dev": { "cache": false, "persistent": true, "env": ["NODE_ENV"] }
  }
}
