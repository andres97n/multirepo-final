# Compose env for the api container. Copy to docker/api.env (gitignored) and fill in the secrets.
# Production rules apply: weak or example secrets, a missing required var and CORS_ORIGIN=* stop the boot.

# Runtime environment (the image sets production; keep it)
NODE_ENV=production

# HTTP port inside the container
PORT=3001

# Express "trust proxy" hop count (0 = disabled, 1 = trust one reverse proxy)
TRUST_PROXY=0

# Comma-separated allowlist of CORS origins (never "*" in production)
CORS_ORIGIN=http://localhost:3000

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Serve OpenAPI at /api/docs in production (always on outside production)
API_DOCS_ENABLED=false

# @module:db-mongo
# MongoDB connection string for the `mongo` compose service (no published port); the password must match MONGO_APP_PASSWORD in docker/mongo.env
MONGO_URI=mongodb://app:<MONGO_APP_PASSWORD>@mongo:27017/app
# @end-module:db-mongo

# @module:db-postgres
# PostgreSQL connection string for the `postgres` compose service; use the non-superuser app role; the password must match APP_DB_PASSWORD in docker/postgres.env
# DATABASE_URL=postgres://app:<APP_DB_PASSWORD>@postgres:5432/app
# @end-module:db-postgres

# @module:auth
# HMAC secret signing access JWTs (>= 32 bytes, not an example value). Required in production.
# generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
# JWT issuer and audience claims checked on every request
JWT_ISSUER=multirepo-api
JWT_AUDIENCE=multirepo-web
# Access token lifetime in seconds (15 min)
JWT_ACCESS_TTL_SECONDS=900
# Refresh session expiry: days since last use, days since login, and the post-rotation replay grace in seconds (max 10)
REFRESH_IDLE_TTL_DAYS=7
REFRESH_FAMILY_TTL_DAYS=30
REFRESH_GRACE_SECONDS=10
# Argon2id parameters (memory KiB, iterations, parallelism)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Progressive lockout: failures before lock, first lock seconds, doubling cap seconds
LOCKOUT_THRESHOLD=5
LOCKOUT_BASE_SECONDS=60
LOCKOUT_MAX_SECONDS=900
# In-process revocation cache TTL in seconds (0 disables; max 30)
AUTH_REVOCATION_CACHE_TTL_SECONDS=15
# Stricter per-IP throttle for POST /auth/login (requests per window)
LOGIN_THROTTLE_LIMIT=10
LOGIN_THROTTLE_TTL_MS=60000
# Interval (minutes) between expired-session cleanups
SESSION_CLEANUP_INTERVAL_MINUTES=60
# Credentials for `seed:admin` run inside the container (optional; never keep a real password in this file)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# @end-module:auth
