# Compose env for the mongo container. Copy to docker/mongo.env (gitignored) and fill in the passwords.
# Setting a root user turns on authentication. The api connects as the least-privilege `app` user.
MONGO_INITDB_ROOT_USERNAME=root
# generate: openssl rand -base64 36 | tr -d '/+='
MONGO_INITDB_ROOT_PASSWORD=
# Password of the `app` user (readWrite on db `app`); must match MONGO_URI in docker/api.env
MONGO_APP_PASSWORD=
