# Compose env for the web container. Copy to docker/web.env (gitignored) and fill in the secrets.
# APP_ORIGIN is also baked into the image at build time (compose build arg): keep both equal.

# Runtime environment (the image sets production; keep it)
NODE_ENV=production

# API_URL (required): base URL of the API on the compose network, without /api/v1
API_URL=http://api:3001

# API_TIMEOUT_MS (optional): timeout for server-side API fetches. Default 5000.
API_TIMEOUT_MS=5000

# @module:auth
# APP_ORIGIN (required): public origin of this web app (scheme + host [+ port]).
# Used for CSRF origin checks and serverActions.allowedOrigins.
APP_ORIGIN=http://localhost:3000

# SESSION_SECRET (required): at least 32 bytes and not an example value; encrypts the session cookie.
# generate: openssl rand -base64 48
SESSION_SECRET=

# SESSION_MAX_AGE_SECONDS (optional): session cookie lifetime (refresh idle
# TTL). Default 604800 (7 days).
SESSION_MAX_AGE_SECONDS=604800

# SESSION_REFRESH_SKEW_SECONDS (optional): refresh the access token when it
# expires within this window. Default 60.
SESSION_REFRESH_SKEW_SECONDS=60
# @end-module:auth
