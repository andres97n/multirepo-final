{
  "name": "multirepo-final",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "boilerplate": {
    "version": "0.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:db": "docker compose -f compose.dev.yaml up -d --wait mongo",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  }
}
