{
  "name": "multirepo-final",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.13+sha512.d5caa9cdcd6067ac2902f9f44daa00b1288a73babf1e98f4f375b3a7583b1894b4d49f7527da8f5e1530198bb10e03adba321a1f015429dc2946ce8a7a9a8c65",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "boilerplate": {
    "version": "0.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:db": "docker compose -f compose.dev.yaml up -d --wait mongo",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:web": "turbo run build --filter=api... --filter=\"web^...\" && pnpm --filter web test:e2e:web",
    "test:e2e:web:ui": "turbo run build --filter=api... --filter=\"web^...\" && pnpm --filter web test:e2e:web:ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@repo/config-eslint": "workspace:*",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  }
}
