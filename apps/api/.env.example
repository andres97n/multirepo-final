# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=3001

# Express "trust proxy" hop count (0 = disabled, 1 = trust one reverse proxy)
TRUST_PROXY=0

# Comma-separated allowlist of CORS origins (never "*" in production)
CORS_ORIGIN=http://localhost:3000

# Rate limiting: window in milliseconds and max requests per window per IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Serve OpenAPI at /api/docs in production (always on outside production)
API_DOCS_ENABLED=false

# @module:db-mongo
# MongoDB connection string (mongodb:// or mongodb+srv://)
MONGO_URI=mongodb://localhost:27017/app
# Server selection and connect timeout in milliseconds
MONGO_TIMEOUT_MS=3000
# @end-module:db-mongo
