{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js 16 web app — validated server-only env, typed server API client, error handling, health route, security headers and a tested CSP strategy.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:e2e:web": "playwright test",
    "test:e2e:web:ui": "playwright test --ui"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@repo/ui": "workspace:*",
    "jose": "6.2.18",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@repo/config-eslint": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vitest-axe": "0.1.0"
  }
}
