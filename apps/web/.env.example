# apps/web — copy to .env.local (or export) and adjust.
# Validated at boot and at `next build` by src/lib/env.schema.ts; invalid or
# missing variables fail with their NAMES. Never expose these to the browser:
# there are deliberately no NEXT_PUBLIC_* variables.

# API_URL (required): base URL of the NestJS API, without the /api/v1 suffix.
API_URL=http://localhost:3001

# API_TIMEOUT_MS (optional): timeout for server-side API fetches. Default 5000.
API_TIMEOUT_MS=5000

# CSP_REPORT_URI (optional): endpoint for CSP report-uri / report-to.
# CSP_REPORT_URI=https://example.com/csp-report

# @module:auth
# APP_ORIGIN (required): public origin of this web app (scheme + host [+ port]).
# Used for CSRF origin checks and serverActions.allowedOrigins.
APP_ORIGIN=http://localhost:3000

# SESSION_SECRET (required): at least 32 bytes; encrypts the session cookie
# (jose dir/A256GCM). Generate with: openssl rand -base64 48
# The value below is an example and is rejected in production.
SESSION_SECRET=example-session-secret-replace-me-0123456789

# SESSION_SECRET_PREVIOUS (optional): previous secret, accepted for decryption
# while rotating keys. Never use it to encrypt new sessions.
# SESSION_SECRET_PREVIOUS=example-previous-secret-replace-me-0123456789

# SESSION_MAX_AGE_SECONDS (optional): session cookie lifetime (refresh idle
# TTL). Default 604800 (7 days).
SESSION_MAX_AGE_SECONDS=604800

# SESSION_REFRESH_SKEW_SECONDS (optional): refresh the access token when it
# expires within this window. Default 60.
SESSION_REFRESH_SKEW_SECONDS=60
# @end-module:auth
