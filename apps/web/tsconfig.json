{
  "extends": "@repo/config-typescript/next.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "*.ts",
    "*.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
